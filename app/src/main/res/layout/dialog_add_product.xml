<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etDialogProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Product Name"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinnerDialogCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnDialogAddCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Category"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp" />

    </LinearLayout>

    <EditText
        android:id="@+id/etDialogProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Selling Price ($)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDialogProductCost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cost Price ($)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDialogProductQty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Initial Quantity / Stock"
        android:inputType="number" />

</LinearLayout>
