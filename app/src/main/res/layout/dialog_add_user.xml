<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etDialogUserFullName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Full Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDialogUserUsername"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Username (unique)"
        android:inputType="textNoSuggestions"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDialogUserPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/edit_text_bg"
        android:hint="PIN (4-8 digits)"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Assigned Role"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_bg">

        <Spinner
            android:id="@+id/spinnerDialogUserRole"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp" />
    </FrameLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchDialogUserActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Account Active"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

</LinearLayout>
